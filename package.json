{
  "name": "harmonyos-dev-mcp-for-dsh",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: bridges the harmonyos-dev-mcp Python MCP server (device discovery, build/deploy, UI automation, E2E inspection, log validation) into DSH as mcp__harmonyos__* tools. Zero npm dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "bin/",
    "cordis.patch.yml",
    "src/",
    "docs/",
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "LICENSE",
    "!src/**/__pycache__/",
    "!src/**/*.py[cod]",
    "!docs/**/__pycache__/"
  ],
  "scripts": {
    "prepare": "node bin/prepare.cjs",
    "check": "node bin/check.js",
    "pack:check": "npm pack --dry-run",
    "publish": "npm publish --access public"
  },
  "dependencies": {},
  "license": "Apache-2.0",
  "homepage": "https://github.com/NormanFxxkingRockwell/harmonyos-dev-mcp-for-dsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NormanFxxkingRockwell/harmonyos-dev-mcp-for-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/NormanFxxkingRockwell/harmonyos-dev-mcp-for-dsh/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "plugin",
    "harmonyos",
    "openharmony",
    "hdc",
    "mcp",
    "mobile",
    "ui-automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}